{
  "song": "一笑江湖",
  "artist": "闻人听書_",
  "lines": [
    {"t": 1.94,  "end": 5.11,  "text": "江湖一笑 浪滔滔"},
    {"t": 5.11,  "end": 7.88,  "text": "红尘尽忘了"},
    {"t": 7.88,  "end": 12.77, "text": "俱往矣 何足言道"},
    {"t": 12.77, "end": 16.11, "text": "苍天一笑 笑不老"},
    {"t": 16.11, "end": 18.99, "text": "豪情却未了"},
    {"t": 18.99, "end": 23.67, "text": "对月饮 一杯寂寥"},
    {"t": 23.67, "end": 30.19, "text": "剑起江湖恩怨 拂袖罩明月"},
    {"t": 30.19, "end": 35.94, "text": "西风叶落花谢 枕刀剑难眠"},
    {"t": 35.94, "end": 41.50, "text": "汝为山河过客 却总长叹伤离别"},
    {"t": 41.50, "end": 47.20, "text": "鬓如霜 一杯浓烈"},
    {"t": 47.20, "end": 53.25, "text": "只身走过多少的岁月"},
    {"t": 53.25, "end": 58.86, "text": "侠骨魔心如何来分辨"},
    {"t": 58.86, "end": 64.53, "text": "黄沙之中的残阳如血"},
    {"t": 64.53, "end": 68.59, "text": "这成败 有谁来了解"},
    {"t": 68.59, "end": 72.80, "text": "江湖一笑 浪滔滔"},
    {"t": 72.80, "end": 75.29, "text": "红尘尽忘了"},
    {"t": 75.29, "end": 79.49, "text": "俱往矣 何足言道"},
    {"t": 79.49, "end": 83.89, "text": "苍天一笑 笑不老"},
    {"t": 83.89, "end": 86.77, "text": "豪情却未了"},
    {"t": 86.77, "end": 89.10, "text": "对月饮 一杯寂寥"}
  ]
}
