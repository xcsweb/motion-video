  "subtitles": [
    {"t": 4.30, "end": 8.25, "lines": ["走得越远，", "越知道自己走不完这个世界。"]},
    {"t": 9.60, "end": 11.90, "lines": ["后来我不再急着赶路。"]},
    {"t": 13.30, "end": 16.50, "lines": ["在陌生的山谷里，等一场雾散。"]},
    {"t": 17.30, "end": 20.75, "lines": ["在无人的海边，", "看浪把脚印抹平。"]},
    {"t": 21.60, "end": 24.25, "lines": ["旅行不是去更多的地方，"]},
    {"t": 24.60, "end": 27.40, "lines": ["而是让一个地方，", "真正经过你。"]},
    {"t": 28.40, "end": 30.60, "lines": ["世界很大，我们很小。"]},
    {"t": 32.20, "end": 36.30, "lines": ["但每一次出发，", "都是把自己重新交还给世界。"]},
    {"t": 40.30, "end": 44.25, "lines": ["所以走吧，", "哪怕只能走到下一次日落。"]},
    {"t": 46.00, "end": 48.00, "lines": ["剩下的路，交给风。"]}
  ],
