#!/usr/bin/env python3
"""ffmpeg 包装器：在 4GB 内存的沙箱里限制解码/编码/滤镜线程，避免 OOM。"""
import os
import sys

REAL = "/usr/bin/ffmpeg"


def main() -> None:
    args = sys.argv[1:]
    out = ["-filter_complex_threads", "1"]
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-i":
            out += ["-threads", "1", "-i"]
        elif a == "-c:v":
            out += ["-threads", "1", "-c:v"]
        else:
            out.append(a)
        i += 1
    os.execv(REAL, [REAL] + out)


if __name__ == "__main__":
    main()
